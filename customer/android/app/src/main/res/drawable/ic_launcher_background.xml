<?xml version="1.0" encoding="utf-8"?>
<!-- The brand gradient, as the adaptive icon's background layer. The foreground
     is now the white mark on transparency, so this is what gives the icon its
     colour. It used to be the stock Android Studio pattern, unused because the
     foreground was a full-bleed tile that covered it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="45"
        android:startColor="#452D9B"
        android:endColor="#07C8D0" />
</shape>
